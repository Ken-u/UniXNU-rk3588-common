+// A core that never arrives only stalls processor_start()'s helper thread, silently. This thread says so 5 s after CPU_ON, with the breadcrumbs the
+// core left in the reset path: stage 5 with a TTBR1/TCR of zero means it read stale memory with its MMU off (osfmk/arm64/start.s).
+static void smpWatch (void *argument, wait_result_t)
+{
+  const unsigned id = static_cast<unsigned> (reinterpret_cast<uintptr_t> (argument)) & 7;
+  IOSleep (5000);
+  if (armcpu_smp_step[id] >= 7) {
+    printf ("armcpu: cpu %u running, %u MHz\n", id, armcpu_core_mhz[id]);
+  } else {
+    volatile uint64_t *t = &rk3588_smp_trace[id * 16];
+    __asm__ volatile ("dc civac, %0\n\tdc civac, %1\n\tdsb sy" :: "r" (t), "r" (t + 8) : "memory");
+    printf ("armcpu: smp bring-up failed: cpu %u is at step %u after 5 s (running %u); reset path stage %u el %#llx/%#llx ttbr1 %#llx tcr %#llx ttbr0 %#llx\n",
+            id, armcpu_smp_step[id], armcpu_smp_running, static_cast<uint32_t> (t[0]), t[1], t[3], t[7], t[8], t[9]);
+  }
+  thread_terminate (current_thread ());
 }
 
