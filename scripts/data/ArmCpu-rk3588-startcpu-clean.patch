+// This core's clock in MHz: the PMU cycle counter against the 24 MHz architected counter over 2 ms. Nothing in this port manages the CPU clocks, so
+// what the firmware left is what runs (boot-arg armcpu-mhz=0 turns the measurement off).
+static uint32_t measureMhz (void)
+{
+  unsigned enabled = 1;
+  PE_parse_boot_argn ("armcpu-mhz", &enabled, sizeof (enabled));
+  if (!enabled) { return 0; }
+  uint64_t freq, pmcr, c0, c1, t0, t1;
+  __asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (freq));
+  __asm__ volatile ("mrs %0, pmcr_el0" : "=r" (pmcr));
+  pmcr = (pmcr | 1) & ~8ULL;   // E = 1, D = 0: count every cycle
+  __asm__ volatile ("msr pmcr_el0, %0\n\tmsr pmcntenset_el0, %1\n\tisb" :: "r" (pmcr), "r" (1ULL << 31) : "memory");
+  t0 = counter ();
+  __asm__ volatile ("mrs %0, pmccntr_el0" : "=r" (c0));
+  do { t1 = counter (); } while (t1 - t0 < freq / 500);
+  __asm__ volatile ("mrs %0, pmccntr_el0" : "=r" (c1));
+  return static_cast<uint32_t> ((c1 - c0) * freq / (t1 - t0) / 1000000);
+}
