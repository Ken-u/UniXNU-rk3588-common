--- a/ArmCpu.cpp
+++ b/ArmCpu.cpp
@@ -32,6 +32,11 @@
 volatile uint32_t armcpu_core_timer[8], armcpu_core_sgi[8];   // per logical core: architectural timer interrupts and SGI 0 taken
 static bool gSpiIpi = false;                // boot-arg armcpu-spi-ipi=1: IPIs are software-pended SPIs 1008+core routed to that core (ICC_SGI1R_EL1 generates nothing on this board)
 static bool gSelfIpi = false;               // boot-arg armcpu-self-ipi=1: every core sends itself SGI 0 from initCPU
+// boot-arg armcpu-mmio-sgi=1: an IPI sets SGI 0 pending through the TARGET core's own redistributor frame (GICR_ISPENDR0, SGI frame + 0x200).
+// FALLBACK ONLY, default off since emmc5w: its premise "ICC_SGI1R_EL1 from non-secure EL1 generates nothing on the GIC-600" was a build artifact, the
+// stock "dsb ishst; msr icc_sgi1r_el1, %0; isb" is a lone dsb for the Darwin assembler (';' = comment). With the msr present (ArmCpu-evb10-sep-asm.patch) ICC works: runs/emmc5w "ipi lab: A2./A3./B.".
+static bool gMmioSgi = false;
+volatile uint32_t armcpu_core_sgi_sent[8];  // per target logical core: IPIs the kernel asked for (compare with armcpu_core_sgi, SGIs taken)
 volatile uint32_t armcpu_irq_phase = 0,armcpu_irq_id = 1023;
 volatile uint32_t armcpu_quiesce_calls = 0,armcpu_halt_calls = 0;
 // Secondary-CPU bring-up evidence (sheng-smp=1). Step values: 1 nub started, 2 registered, 3 start thread running,
@@ -367,6 +372,9 @@
   unsigned spiIpi = 0;
   PE_parse_boot_argn ("armcpu-spi-ipi", &spiIpi, sizeof (spiIpi));
   gSpiIpi = spiIpi == 1;
+  unsigned mmioSgi = 0;
+  PE_parse_boot_argn ("armcpu-mmio-sgi", &mmioSgi, sizeof (mmioSgi));
+  gMmioSgi = mmioSgi == 1;
   unsigned diagnostic = 0;
   PE_parse_boot_argn("armcpu-diagnostics", &diagnostic, sizeof(diagnostic));
   diagnosePower=diagnostic==1;
@@ -617,6 +625,14 @@
   uint64_t sgi = ((aff & 0xff00000000ULL) << 16) | ((aff & 0xff0000) << 16) |
                  ((aff & 0xff00) << 8) | (1ULL << (aff & 0xff));
   armcpu_ipi_sent = armcpu_ipi_sent + 1;
+  __atomic_fetch_add (&armcpu_core_sgi_sent[peer->logicalId & 7], 1U, __ATOMIC_RELAXED);
+  if (gMmioSgi && peer->redist != 0) {
+    // The cpu_signal word was stored before this call (dsb ishst in cpu_signal_internal); order it before the device write as well.
+    __asm__ volatile ("dsb ishst" ::: "memory");
+    write32 (peer->redist + 0x10000, 0x200, 1U);   // GICR_ISPENDR0: SGI 0 pending in the target's redistributor
+    __asm__ volatile ("dsb sy" ::: "memory");
+    return;
+  }
   if (gSpiIpi) { spiIpiSend (gDist, peer->logicalId & 7); return; }
   __asm__ volatile ("dsb ishst; msr icc_sgi1r_el1, %0; isb" :: "r" (sgi) : "memory");
 }
