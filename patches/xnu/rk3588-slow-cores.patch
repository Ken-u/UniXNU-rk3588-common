+	const uint64_t slow_cpus = (sched_slow_cpu_mask != 0 && thread->base_pri >= sched_slow_min_pri) ? (uint64_t)sched_slow_cpu_mask : 0;
+	if (slow_cpus != 0 && processor != PROCESSOR_NULL && bit_test(slow_cpus, processor->cpu_id)) {
+		processor = PROCESSOR_NULL;
+	}
+
 	/*
 	 * Only consult platform layer if pset is active, which
 	 * it may not be in some cases when a multi-set system
@@ -5332,6 +5388,26 @@
 		 * Choose an idle processor, in pset traversal order
 		 */
 		uint64_t idle_primary_map = (pset->cpu_state_map[PROCESSOR_IDLE] & pset->primary_map & pset->recommended_bitmask);
+		bool slow_cpus_avoided = false;
+
+		if (slow_cpus != 0) {
+			const int ui = thread->base_pri >= 46 ? 0 : 1;
+
+			sched_slow_stat[ui][0]++;
