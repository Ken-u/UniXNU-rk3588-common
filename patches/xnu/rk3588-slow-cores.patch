+			} else if (choose_processor_fast_victim(pset, thread, slow_cpus)) {
+				/* no fast core is idle, but one is running something less important: the search below preempts that one, not a slow core */
+				idle_primary_map = 0;
+				slow_cpus_avoided = true;
+				sched_slow_stat[ui][2]++;
+			} else {
+				sched_slow_stat[ui][3]++;
+			}
+		}
