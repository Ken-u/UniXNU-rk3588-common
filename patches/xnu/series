# RK3588 XNU patches, applied after the ARM64 series and before the OS and device series.
# Two UniXNU base patches are not in the ARM64 series although later patches quote their context:
# native-smp-secondary sets MAX_CPUS 8 and the Affinity1 core numbering, and sheng-platform-power adds the
# bsd_init.c block that the OS series' zzz-boot-progress.patch uses as context (CONFIG_XNU_SHENG_PMGR is off,
# so the block compiles to nothing).
arch:../../../patches/xnu/native-smp-secondary.patch
arch:../../../patches/xnu/sheng-platform-power.patch
# 16550-compatible console (RK3588 UART2, Synopsys DesignWare APB UART) from the /arm-io node "uart16550"
rk3588-pe-serial-16550.patch
# Reset and restart through PSCI (nothing else implements IOPlatformExpert::haltRestart here)
rk3588-psci-restart.patch
# Secondary cores: PSCI starts them at EL2; drop to EL1 before XNU's reset vector
rk3588-smp-el2.patch
# The boot CPU is the /cpus node whose reg is the booting core's MPIDR, not the first node (which the host tool marks "running"), so the device tree can
# list the Cortex-A76 cores first and the scheduler, which takes the lowest-numbered idle core, prefers them
rk3588-boot-cpu-mpidr.patch
# The scheduler sees the four Cortex-A55 and four Cortex-A76 cores as one kind of core. sched-slowcpus=<mask of logical CPU numbers> (boot-arg, off by default)
# keeps threads of the user-initiated and interactive QoS classes off the slow cores while a fast core is idle or can be preempted
rk3588-slow-cores.patch
# EL0 may read CTR_EL0 (Mesa sizes its cache maintenance from it)
rk3588-sctlr-uct.patch
# Personality of the DesignWare MSHC eMMC host (Rk3588Emmc, class NativeEmmc)
rk3588-emmc-personality.patch
# The eMMC driver vouches for the owner's read-only root volume when the owner asks for it (emmc-root-trust=1)
rk3588-root-trust.patch
