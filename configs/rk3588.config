# RK3588: four Cortex-A55 and four Cortex-A76 (ARMv8.2, PAN), GICv3 (GIC-600), 24 MHz generic timer.
# There is no Apple silicon block, so every Apple-only native driver stays off; the platform expert,
# ArmCpu and the architected timer come from the ARM64 profile.
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_NATIVE_VIRTIO_CONSOLE=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
# The ARM64 profile enables NativeAES (Qualcomm crypto engine); the RK3588 has no such device.
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
